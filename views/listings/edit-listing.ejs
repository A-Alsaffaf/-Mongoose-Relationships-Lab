<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Listing</title>
</head>
<body>
    <%- include('../partials/navbar.ejs') %>
    <h1>Edit listing</h1>

    <form action="/listings/<%= listing._id%>?_method=PUT" method="post">
        <label for="streetAddress">Street Address: </label>
        <input type="text" id="streetAddress" name="streetAddress" value="<%= listing.streetAddress  %>">

        <label for="city">City: </label>
        <input type="text" id="city" name="city" value="<%= listing.city  %>">

        <label for="price">Price: </label>
        <input type="text" id="price" name="price" value="<%= listing.price  %>">

        <label for="size">Size: </label>
        <input type="text" id="size" name="size" value="<%= listing.size  %>">

        <label for="owner">Owner ID: </label>
        <input type="text" id="owner" name="owner" value="<%= listing.owner._id %>">

        <label for="category">Category ID: </label>
        <input type="text" id="category" name="category" value="<%= listing.category._id  %>">

        <button type="submit">Edit Listing</button>
    </form>
</body>
</html>